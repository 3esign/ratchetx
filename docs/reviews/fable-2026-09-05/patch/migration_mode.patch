diff --git a/test/test_migration_mode.mjs b/test/test_migration_mode.mjs
new file mode 100644
index 0000000..90b95ed
--- /dev/null
+++ b/test/test_migration_mode.mjs
@@ -0,0 +1,124 @@
+// MIGRATION MODE HAS TO BE EXERCISED, NOT DESCRIBED.
+//
+// RX_MIGRATION_MODE=1 retires the legacy store: every store-backed action of
+// api/game.js must answer with one named 503 (MIGRATION_MODE) that tells a
+// player and an agent the same true thing -- the game is moving on-chain,
+// nothing is claimable, no wallet action -- instead of a 500 from a dead store
+// or, worse, a stale "state" that looks alive. Like test_migration_freeze.mjs
+// this loads api/game.js twice against one shared store: once live, once in
+// migration mode, and asserts:
+//
+//   live:      state reads, a shot sells                (so the refusal is not a fault)
+//   migration: EVERY action answers 503 MIGRATION_MODE  (state, shot, reload, anchor, play-session, agent-report)
+//              the reason names the no-wallet-action rule
+//              the store is never touched               (no key written, no lock taken)
+//              CORS headers still come back              (agents see the refusal, not a network error)
+import { createRequire } from 'node:module';
+const require = createRequire(import.meta.url);
+
+process.env.RATCHET_MINT = process.env.RATCHET_MINT || 'FQb2EyaLZ9TWBemYmQ9zWtXcEwLiSXtz7j619ThQpump';
+delete process.env.RX_MIGRATION_MODE;
+delete process.env.RX_MIGRATION_FREEZE;
+
+const pricesPath = require.resolve('../lib/prices.js');
+const burnPath = require.resolve('../lib/burn.js');
+const gamePath = require.resolve('../api/game.js');
+const TEST_FEEDS = ['SOL','BTC','ETH','BONK','WIF','JUP','PUMP'];
+const PX = { src:'pyth-onchain', SOL:100, BTC:60000, ETH:2000, BONK:0.000002, WIF:0.1, JUP:0.2, PUMP:0.005 };
+require.cache[pricesPath] = { id: pricesPath, filename: pricesPath, loaded: true,
+  exports: { getPrices: async () => { const t = Math.floor(Date.now()/1000); return { ...PX,
+    ages: Object.fromEntries(TEST_FEEDS.map(f=>[f,1])),
+    confs: Object.fromEntries(TEST_FEEDS.map(f=>[f,10])),
+    pubs: Object.fromEntries(TEST_FEEDS.map(f=>[f,t])),
+    prevPubs: Object.fromEntries(TEST_FEEDS.map(f=>[f,t-60])),
+    slots: Object.fromEntries(TEST_FEEDS.map((f,i)=>[f,300000+i])),
+    postedSlots: Object.fromEntries(TEST_FEEDS.map((f,i)=>[f,299900+i])),
+    emaPrices: Object.fromEntries(TEST_FEEDS.map(f=>[f,PX[f]])),
+    emaConfs: Object.fromEntries(TEST_FEEDS.map(f=>[f,8])) }; } } };
+require.cache[burnPath] = { id: burnPath, filename: burnPath, loaded: true,
+  exports: { INCINERATOR: '1nc1nerator11111111111111111111111111111111',
+    rpcCall: async (m) => (m === 'getTokenAccountsByOwner' ? { value: [] } : null),
+    getTx: async () => null, decideBurn: () => ({ ok:false, reason:'stub' }) } };
+
+let game = require('../api/game.js');
+const mem = globalThis.__ratchet_mem;
+const reload = on => {
+  if (on) process.env.RX_MIGRATION_MODE = '1'; else delete process.env.RX_MIGRATION_MODE;
+  delete require.cache[gamePath];
+  game = require('../api/game.js');
+};
+const call = (method, { query = {}, body = null, ip = '9.9.9.9' } = {}) =>
+  new Promise(resolve => {
+    const req = { method, query, body, headers: { 'x-forwarded-for': ip }, socket: {} };
+    const res = { _status: 200, _headers: {},
+      setHeader(n,v){ this._headers[String(n).toLowerCase()] = String(v); },
+      status(c){ this._status = c; return this; },
+      end(){ resolve({ status:this._status, body:null, headers:this._headers }); },
+      json(o){ resolve({ status:this._status, body:o, headers:this._headers }); } };
+    game(req, res).catch(e => resolve({ status:599, body:{ ok:false, reason:String(e) } }));
+  });
+let fails = 0, checks = 0;
+const ok = (cond, name) => { checks++; console.log((cond?'PASS':'FAIL')+'  '+name); if (!cond) fails++; };
+const resetRL = () => { const rl = globalThis.__ratchet_rl; if (rl && rl.clear) rl.clear(); };
+
+const HOUR = Math.floor(Date.now() / 3600e3);
+const TARGET5 = `H${HOUR}Q0`;
+const W = 'demo-migmode01';
+
+// ---- 1. live baseline ----------------------------------------------------
+{
+  const s = await call('GET', { query: { action:'state', wallet: W } });
+  ok(s.status === 200 && s.body.ok === true, 'baseline: state reads while migration mode is off');
+  const r = await call('POST', { body: { action:'shot', auth:{wallet:W}, target:TARGET5, side:'YES', stake:500 } });
+  ok(r.body.ok === true, 'baseline: the machine sells while migration mode is off');
+}
+const keysBefore = [...mem.keys()].sort().join('|');
+
+// ---- 2. migration mode on ------------------------------------------------
+reload(true); resetRL();
+const actions = [
+  ['GET',  { query: { action:'state', wallet: W } }, 'state'],
+  ['GET',  { query: { action:'board' } }, 'board'],
+  ['POST', { body: { action:'shot', auth:{wallet:'demo-migmode02'}, target:TARGET5, side:'YES', stake:500 } }, 'shot'],
+  ['POST', { body: { action:'reload', auth:{wallet:W}, sig:'x' } }, 'reload'],
+  ['POST', { body: { action:'anchor', auth:{wallet:W} } }, 'anchor'],
+  ['GET',  { query: { action:'agent-report', id: W } }, 'agent-report (rewritten /api/agent)'],
+  ['POST', { query: { action:'play-session' }, body: {} }, 'play-session'],
+  ['GET',  { query: { action:'gauntlet' } }, 'gauntlet (rewritten /api/gauntlet)'],
+];
+for (const [method, opts, name] of actions) {
+  resetRL();
+  const r = await call(method, opts);
+  ok(r.status === 503 && r.body && r.body.code === 'MIGRATION_MODE', `migration: ${name} answers 503 MIGRATION_MODE (got ${r.status} ${r.body && r.body.code})`);
+}
+{
+  resetRL();
+  const r = await call('GET', { query: { action:'state', wallet: W } });
+  ok(/moving on-chain/i.test(r.body.reason||'') && /no wallet action/i.test(r.body.reason||''),
+    'migration: the reason says the game is moving on-chain and that no wallet action is required');
+  ok(/not us/i.test(r.body.reason||''), 'migration: the reason warns that a "claim RatchetX" prompt before the announcement is not us');
+  ok(r.body.durable === false && typeof r.body.v === 'string' && r.body.v.length > 0,
+    'migration: durable:false and the release marker travel with the refusal, so /api/proof and a client can still tell which build answered');
+  ok(r.headers['access-control-allow-origin'] === '*', 'migration: CORS still answers, so an agent sees a named refusal rather than a network error');
+  ok(r.headers['cache-control'] === 'no-store' && r.headers['retry-after'] === '3600', 'migration: no-store + retry-after, so caches and agents back off honestly');
+  ok(r.body.reason === game.MIGRATION_MODE_REASON, 'migration: the sentence is exported once, for the client and the docs to reuse verbatim');
+}
+{
+  resetRL();
+  const o = await call('OPTIONS', {});
+  ok(o.status === 204, 'migration: CORS preflight still answers 204');
+}
+const keysAfter = [...mem.keys()].sort().join('|');
+ok(keysAfter === keysBefore, 'migration: no key in the store was written or created by any refused action');
+ok(![...mem.keys()].some(k => k.startsWith('lock:u:demo-migmode02')), 'migration: no player lock was taken for the refused shot');
+
+// ---- 3. off again: the same store still serves --------------------------
+reload(false); resetRL();
+{
+  const s = await call('GET', { query: { action:'state', wallet: W } });
+  ok(s.status === 200 && s.body.ok === true && Array.isArray(s.body.player && s.body.player.open) && s.body.player.open.length === 1,
+    'after: the store is untouched -- the open shot from the baseline is still there');
+}
+
+console.log(`\n${checks - fails}/${checks} passed`);
+process.exit(fails ? 1 : 0);
