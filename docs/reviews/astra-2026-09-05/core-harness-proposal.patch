+    // Preserve detailed result assertions after M3: rows are emitted events,
+    // while the fixed account authenticates their count, mask and rolling root.
+    fn record_archives(&mut self, logs: &[String]) {
+        let mut stack: Vec<&str> = Vec::new();
+        for line in logs {
+            if let Some(program) = line.strip_prefix("Program ") {
+                if let Some((id, _)) = program.split_once(" invoke [") {
+                    stack.push(id);
+                } else if let Some(id) = program.strip_suffix(" success") {
+                    assert_eq!(stack.pop(), Some(id));
+                } else if let Some((id, _)) = program.split_once(" failed: ") {
+                    assert_eq!(stack.pop(), Some(id));
+                }
+            }
+            if let Some(encoded) = line.strip_prefix("Program data: ") {
+                let bytes = BASE64.decode(encoded).expect("valid event base64");
+                if bytes.starts_with(&discriminator("event", "ShotArchived")) {
+                    assert_eq!(
+                        stack.last().copied(),
+                        Some(core_program().to_string().as_str()),
+                        "ShotArchived must be emitted by the pinned Core program"
+                    );
+                    assert_eq!(bytes.len(), 154 + SHOT_RESULT_LEN);
+                    self.archived_events.push(bytes);
+                }
+            }
+        }
+        assert!(stack.is_empty());
+    }
+
+    fn archived_row(
+        &self,
+        history_key: Pubkey,
+        economy: &[u8; 32],
+        player: &Pubkey,
+        nonce: u64,
+    ) -> Vec<u8> {
+        let page = self.svm.get_account(&history_key).expect("fixed HistoryPage");
+        assert_eq!(page.owner, core_program());
+        assert_eq!(page.data.len(), HISTORY_BASE_LEN);
+        assert_eq!(&page.data[..8], &discriminator("account", "HistoryPage"));
+        assert_eq!(read_u16(&page.data, 8), SCHEMA);
+        assert_eq!(&page.data[11..43], economy);
+        assert_eq!(&page.data[43..75], player.as_ref());
+        let page_index = read_u64(&page.data, 75);
+        assert_eq!(history_key, history_page_pda(economy, player, page_index));
+        assert_eq!(page_index, nonce / 16);
+        let pending = page.data[HISTORY_PENDING_OFFSET];
+        assert!(pending <= 16);
+        let mut root = [0u8; 32];
+        let mut mask = 0u16;
+        let mut sequence = 0u8;
+        let mut selected = None;
+        for event in self.archived_events.iter().filter(|event| {
+            &event[8..40] == economy && &event[40..72] == player.as_ref()
+                && read_u64(event, 80) == page_index
+        }) {
+            let event_nonce = read_u64(event, 72);
+            assert_eq!(event_nonce / 16, page_index);
+            let slot = event[88];
+            assert_eq!(slot as u64, event_nonce % 16);
+            assert!(slot < pending);
+            assert_eq!(mask & (1u16 << slot), 0, "no duplicate terminal slot");
+            mask |= 1u16 << slot;
+            sequence += 1;
+            assert_eq!(event[89], sequence, "archive sequence has no omission or repeat");
+            let row = &event[154..];
+            let row_hash = hash_parts(&[b"rcx-core:history-row:g2\0", &event_nonce.to_le_bytes(), row]);
+            assert_eq!(read_hash(event, 90), row_hash);
+            root = hash_parts(&[b"rcx-core:history-chain:g2\0", &root, &row_hash]);
+            assert_eq!(read_hash(event, 122), root);
+            if event_nonce == nonce {
+                assert!(selected.is_none(), "one archive per nonce");
+                selected = Some(row.to_vec());
+            }
+        }
+        assert_eq!(read_u16(&page.data, HISTORY_MASK_OFFSET), mask);
+        assert_eq!(mask.count_ones(), u32::from(sequence));
+        assert_eq!(read_hash(&page.data, HISTORY_ROOT_OFFSET), root);
+        selected.expect("requested nonce has a committed archive event")
     }
 
