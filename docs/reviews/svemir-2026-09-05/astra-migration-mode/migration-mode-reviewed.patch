diff --git a/test/test_migration_mode.mjs b/test/test_migration_mode.mjs
new file mode 100644
index 0000000..8e3e049
--- /dev/null
+++ b/test/test_migration_mode.mjs
@@ -0,0 +1,149 @@
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync } from 'node:fs';
+import { createServer } from 'node:http';
+import { dirname, join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import vm from 'node:vm';
+import { test } from 'node:test';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+const source = name => readFileSync(join(root, name), 'utf8');
+const paused = ['agent-entry', 'blink', 'feeds', 'game', 'ledger', 'log', 'mcp', 'record', 'shot', 'snapshot'];
+const diagnostics = ['proof', 'supply'];
+const pages = ['/', '/index.html', '/agents', '/agents.html', '/gauntlet', '/gauntlet.html', '/observatory', '/observatory.html', '/play-session', '/play-session.html'];
+function loadGuard(env = {}) {
+  const module = { exports: {} };
+  vm.runInNewContext(source('lib/migration_mode.js'), { module, process: { env },
+    require: name => { throw new Error('Migration guard imported ' + name); },
+    fetch: () => { throw new Error('Migration guard requested network'); } });
+  return module.exports;
+}
+function loadRoute(name, guard) {
+  const imports = [];
+  const module = { exports: {} };
+  vm.runInNewContext(source('api/' + name + '.js'), { module,
+    require: name => {
+      imports.push(name);
+      assert.equal(name, '../lib/migration_mode.js', 'Legacy dependency loaded before migration response');
+      return guard;
+    },
+    process: { env: {} },
+    fetch: () => { throw new Error('Legacy route requested network'); },
+    setTimeout: () => { throw new Error('Legacy route scheduled work'); },
+    setInterval: () => { throw new Error('Legacy route scheduled polling'); }
+  }, { filename: 'api/' + name + '.js' });
+  assert.equal(imports.length, 1);
+  assert.equal(typeof module.exports, 'function');
+  return module.exports;
+}
+
+test('migration is the default; only explicit deployment configuration restores legacy', () => {
+  for (const value of [undefined, '', 'migration', 'LEGACY', 'legacy ', 'false', '0']) {
+    assert.equal(loadGuard(value === undefined ? {} : { RATCHETX_SITE_MODE: value }).enabled, true);
+  }
+  assert.equal(loadGuard({ RATCHETX_SITE_MODE: 'legacy' }).enabled, false);
+});
+
+test('every non-diagnostic API loads without any legacy dependency or side effect', () => {
+  const files = readdirSync(join(root, 'api')).filter(f => f.endsWith('.js')).map(f => f.slice(0, -3)).sort();
+  assert.deepEqual(files, [...paused, ...diagnostics].sort(), 'New API requires an explicit migration decision');
+  for (const route of paused) loadRoute(route, loadGuard());
+});
+
+test('explicit legacy configuration reaches the preserved code for all paused APIs', () => {
+  for (const route of paused) {
+    const marker = new Error('legacy reached');
+    const module = { exports: {} };
+    assert.throws(() => vm.runInNewContext(source('api/' + route + '.js'), {
+      module, process: { env: {} },
+      require: name => { if (name === '../lib/migration_mode.js') return loadGuard({ RATCHETX_SITE_MODE: 'legacy' }); throw marker; }
+    }), e => e === marker, route);
+  }
+});
+
+test('real HTTP: hostile query/body/headers cannot bypass 503 or obtain wallet/payment actions', async () => {
+  const handlers = new Map(paused.map(name => ['/api/' + name, loadRoute(name, loadGuard())]));
+  const server = createServer((req, res) => {
+    const handler = handlers.get(new URL(req.url, 'http://localhost').pathname);
+    if (!handler) return res.writeHead(404).end();
+    handler(req, res);
+  });
+  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));
+  try {
+    const base = 'http://127.0.0.1:' + server.address().port;
+    for (const route of paused) {
+      for (const method of ['GET', 'HEAD', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS']) {
+        const response = await fetch(base + '/api/' + route + '?action=claim&mode=legacy&RATCHETX_SITE_MODE=legacy', {
+          method, headers: { 'Content-Type': 'application/json', 'X-Site-Mode': 'legacy', 'X-Payment': 'untrusted', Origin: 'https://example.invalid' },
+          ...(['POST', 'PUT', 'PATCH', 'DELETE'].includes(method) ? { body: JSON.stringify({ mode: 'legacy', action: 'seal', wallet: 'untrusted' }) } : {}),
+          signal: AbortSignal.timeout(5000)
+        });
+        assert.equal(response.status, method === 'OPTIONS' ? 204 : 503, route + ' ' + method);
+        for (const header of ['cache-control', 'cdn-cache-control', 'vercel-cdn-cache-control']) assert.equal(response.headers.get(header), 'no-store');
+        assert.equal(response.headers.get('access-control-allow-origin'), '*');
+        for (const header of ['location', 'www-authenticate', 'x-payment-response', 'payment-required']) assert.equal(response.headers.get(header), null);
+        const text = await response.text();
+        if (method === 'HEAD' || method === 'OPTIONS') { assert.equal(text, ''); continue; }
+        const json = JSON.parse(text);
+        assert.equal(json.ok, false);
+        assert.equal(json.code, 'MIGRATION_IN_PROGRESS');
+        assert.equal(json.claimable, false);
+        assert.equal(json.walletActionRequired, false);
+        assert.match(json.message, /has not happened yet/);
+        for (const field of ['transaction', 'signature', 'payment', 'paymentRequirements', 'session', 'tools']) assert.equal(json[field], undefined);
+      }
+    }
+  } finally {
+    server.closeAllConnections();
+    await new Promise(resolve => server.close(resolve));
+  }
+});
+
+test('migration build check needs no store credentials, imports or network', async () => {
+  const module = { exports: {} }, messages = [];
+  const require = name => { assert.equal(name, './migration_mode.js'); return loadGuard(); };
+  require.main = module;
+  vm.runInNewContext(source('lib/check_store_schema.js'), { module, require, process: { env: {} },
+    console: { log: message => messages.push(message) },
+    fetch: () => { throw new Error('Build requested network'); }
+  });
+  assert.equal(await module.exports.check(), true);
+  assert.equal(messages.length, 1);
+  assert.match(messages[0], /Migration mode/);
+});
+
+test('legacy build still reaches its store prerequisite instead of silently bypassing it', () => {
+  const marker = new Error('legacy prerequisite reached'), module = { exports: {} };
+  assert.throws(() => vm.runInNewContext(source('lib/check_store_schema.js'), {
+    module, process: { env: {} }, require: name => {
+      if (name === './migration_mode.js') return loadGuard({ RATCHETX_SITE_MODE: 'legacy' });
+      throw marker;
+    }
+  }), e => e === marker);
+});
+
+test('public route contract uses the existing inert notice, retains API aliases and disables crons', () => {
+  const config = JSON.parse(source('vercel.json'));
+  for (const page of pages) {
+    assert.equal(config.rewrites.filter(r => r.source === page).length, 1);
+    assert.equal(config.rewrites.find(r => r.source === page).destination, '/claim.html');
+  }
+  for (const alias of ['/api/gauntlet', '/api/agent', '/api/agent-proof-bundle']) {
+    assert.match(config.rewrites.find(r => r.source === alias).destination, /^\/api\/game\?action=/);
+  }
+  assert.deepEqual(config.crons, []);
+  assert.ok(!config.rewrites.some(r => r.source.startsWith('/.well-known')));
+  const notice = source('claim.html');
+  assert.match(notice, /It has not happened yet/);
+  assert.match(notice, /Gameplay is paused/);
+  assert.doesNotMatch(notice, /<script\b|<form\b|<button\b|onclick\s*=/i);
+});
+
+test('diagnostics are retained separately and do not claim a scheduled revocation', () => {
+  for (const name of diagnostics) {
+    assert.doesNotMatch(source('api/' + name + '.js'), /require\(['"]\.\.\/lib\/migration_mode/);
+  }
+  assert.doesNotMatch(source('api/proof.js'), /2026-09-08|'g:proofcache'/);
+  assert.match(source('llms.txt'), /also depend on legacy\s+KV data/);
+  assert.equal(JSON.parse(source('docs/AGENT_STATE.json')).freezeDates.sealV2, null);
+});
