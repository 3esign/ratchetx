diff --git a/lib/migration_mode.js b/lib/migration_mode.js
new file mode 100644
index 0000000..8d2d7bf
--- /dev/null
+++ b/lib/migration_mode.js
@@ -0,0 +1,22 @@
+'use strict';
+// Default closed during migration. Only the deployment owner can explicitly
+// restore legacy mode; request headers, bodies and query parameters cannot.
+const enabled = process.env.RATCHETX_SITE_MODE !== 'legacy';
+const message = 'RatchetX gameplay is paused for migration. The migration has not happened yet. Nothing is claimable and no wallet action is needed.';
+const body = JSON.stringify({ ok: false, status: 'migration', code: 'MIGRATION_IN_PROGRESS',
+  message, reason: message, claimable: false, walletActionRequired: false });
+function respond(req, res) {
+  res.setHeader('Cache-Control', 'no-store');
+  res.setHeader('CDN-Cache-Control', 'no-store');
+  res.setHeader('Vercel-CDN-Cache-Control', 'no-store');
+  res.setHeader('Content-Type', 'application/json; charset=utf-8');
+  res.setHeader('Access-Control-Allow-Origin', '*');
+  res.setHeader('Access-Control-Allow-Methods', 'GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS');
+  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization, X-Payment, Payment-Signature, MCP-Protocol-Version, MCP-Session-Id, X-Action-Version, X-Blockchain-Ids');
+  res.setHeader('X-Content-Type-Options', 'nosniff');
+  // Preflight does not advertise a live payment, wallet or gameplay operation.
+  if (req.method === 'OPTIONS') { res.statusCode = 204; return res.end(); }
+  res.statusCode = 503;
+  return res.end(req.method === 'HEAD' ? undefined : body);
+}
+module.exports = { enabled, respond };
