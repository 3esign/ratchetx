.vercel
.env*
node_modules

backups/

# Signing material never enters this repository, from any path.
*keypair*.json
*.keys/
id.json

# Local Solana deployment authorities (never commit)
onchain/ratchet-seal-v2/.keys/

# Local preflight report written by DEPLOY.cmd. Machine-specific, and it carries
# a local user path — it does not belong in a public repository.
deploy_check.txt

# Local cadence measurements may be long-running and may have been started by
# an older tool version that printed a credential-bearing RPC URL in its header.
stock_cadence_report*.txt

# Local investigation/transcript artifacts never belong in a release.
phases_extracted*.txt
plan_dump.txt
rotate*.js
run_sql.js
test-pyth.mjs
onchain/player-passport/program/*.bak
onchain/player-passport/program/patch.py
onchain/core-passport-benchmark/mpl-core/

# devnet faucet program keypair (throwaway, devnet only) and build
onchain/ratchet-core-devnet/devnet-program-keypair.json
onchain/ratchet-core-devnet/target/
onchain/ratchet-core/target/
onchain/ratchet-core/svm-tests/target/
onchain/rcx-timepin/target/
onchain/rcx-timepin-v2/target/
onchain/rcx-timepin-v2/svm-tests/target/
onchain/ratchet-work-market/target/
onchain/ratchet-work-market/svm-tests/target/
onchain/ratchet-core-g2/target/
onchain/ratchet-core-g2/svm-tests/target/

# devnet drill reports and the shooter's salts (local, regenerated by the .cmd scripts)
devnet_*.txt
devnet_shooter_salts.json
legacy_root.txt

# legacy snapshot inputs carry player records; only merkle_tree.json (root + proofs) is committed
kv_dump.json
merkle_balances.json

# Devnet deploy payer. A keypair NEVER enters this repository.
ops/g2-deploy/keys/
