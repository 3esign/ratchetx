+#[test]
+fn equity_pull_feed_seals_settles_and_hits() {
+    let mut w = World::new();
+    let p = w.player(1000);
+    w.reload(&p, 1000 * UNIT, &[]).unwrap();
+    let cranker = w.player(0);
+    let idx = 7u8; // TSLA, a pull feed
+    let poster = Pubkey::new_unique();
+    let t0 = w.now;
+    // entry: a fresh posted update the seal reads (not the sponsored PDA)
+    let seal_px = Pubkey::new_unique();
+    w.pyth_pull(idx, 412_00000000, 200_000, t0 - 1, t0 - 2, seal_px, poster);
+    let c = commit(&p.pubkey(), 1, "YES", 0, SALT);
+    w.seal_at(&p, 1, c, idx, 5, 500, seal_px).expect("seal on a pull feed");
+    assert_eq!(w.shot(&p.pubkey(), 1).unwrap().entry_e12, 412_000_000_000_000);
+    let expiry = t0 + 5 * 60;
+    // warm the clock with a posted print before expiry
+    let warm = Pubkey::new_unique();
+    w.pyth_pull(idx, 412_00000000, 200_000, t0 + 10, t0 + 8, warm, poster);
+    w.checkpoint_at(&cranker, idx, warm).expect("warm checkpoint");
+    // the first posted print at/after expiry, checkpointed = the crossing
+    w.advance(5 * 60 + 2);
+    let cross = Pubkey::new_unique();
+    w.pyth_pull(idx, 420_00000000, 200_000, expiry + 1, expiry - 1, cross, poster);
+    w.checkpoint_at(&cranker, idx, cross).expect("crossing checkpoint");
+    w.settle(&cranker, &p.pubkey(), 1, idx).expect("settle on a pull feed");
+    assert_eq!(w.shot(&p.pubkey(), 1).unwrap().exit_e12, 420_000_000_000_000);
+    w.reveal(&p, &p.pubkey(), 1, 1, 0, SALT).expect("reveal");
+    let l = w.ledger(&p.pubkey());
+    assert_eq!((l.credits, l.hits, l.open), (1350, 1, 0)); // 1000 - 500 stake + 850 payout
+    assert_eq!(w.shot(&p.pubkey(), 1).unwrap().hit, 1);
+}
