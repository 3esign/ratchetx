+#[test]
+fn pull_guards_hold_and_push_stays_strict() {
+    let mut w = World::new();
+    let p = w.player(1000);
+    w.reload(&p, 1000 * UNIT, &[]).unwrap();
+    let cranker = w.player(0);
+    let poster = Pubkey::new_unique();
+    let c = commit(&p.pubkey(), 1, "YES", 0, SALT);
+    let idx = 7u8; // a pull feed (TSLA)
+
+    // 1. a pull update owned by a stranger program is refused
+    let a1 = Pubkey::new_unique();
+    w.pyth_pull(idx, 412_00000000, 200_000, w.now - 1, w.now - 2, a1, poster);
+    let mut acc = w.svm.get_account(&a1).unwrap();
+    acc.owner = spl_token::id();
+    w.svm.set_account(a1, acc).unwrap();
+    assert_err(w.seal_at(&p, 1, c, idx, 5, 500, a1), "BadPriceAccount");
+
+    // 2. a partially verified pull update is refused
+    let a2 = Pubkey::new_unique();
+    w.pyth_pull(idx, 412_00000000, 200_000, w.now - 1, w.now - 2, a2, poster);
+    let mut acc = w.svm.get_account(&a2).unwrap();
+    acc.data[40] = 0; // VerificationLevel::Partial
+    acc.data.insert(41, 1); // num_signatures
+    w.svm.set_account(a2, acc).unwrap();
+    assert_err(w.seal_at(&p, 1, c, idx, 5, 500, a2), "PartialVerification");
+
+    // 3. a pull update carrying NVDA's feed id is refused for a TSLA checkpoint
+    let a3 = Pubkey::new_unique();
+    w.pyth_pull(8, 100_00000000, 200_000, w.now - 1, w.now - 2, a3, poster); // NVDA data
+    assert_err(w.checkpoint_at(&cranker, idx, a3), "BadFeed");
+
+    // 4. a crypto PUSH feed still requires the sponsored PDA: an arbitrary
+    //    receiver-owned, fully verified account for SOL is refused
+    let a4 = Pubkey::new_unique();
+    w.pyth_pull(0, 100_00000000, 200_000, w.now - 1, w.now - 2, a4, poster);
+    assert_err(w.seal_at(&p, 1, c, 0, 5, 500, a4), "BadPriceAccount");
+}
