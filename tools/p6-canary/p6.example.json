  },
  "economy": { "pda": "<canonical Economy PDA>", "hash": "<economy_hash hex>" },
  "ruleset": { "pda": "<canonical Ruleset PDA>", "hash": "<ruleset_hash hex>" },
  "readset": ["<Economy PDA>", "<Ruleset PDA>"],
  "trackedNeeds": [],
  "needStateOffset": 11,
  "oracle": { "priceAccount": "<pinned Pyth push PriceUpdateV2 account for the feed>", "publishTimeOffset": 0, "_note": "set publishTimeOffset to the i64 publish_time offset inside the PriceUpdateV2 account per the pinned Receiver layout" },
