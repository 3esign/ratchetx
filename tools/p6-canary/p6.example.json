    { "kind": "rollback", "op": "void_active_shot", "subject": "<shot pda whose exit Need is FINAL>", "actor": { "name": "team-sol", "pubkey": "<pubkey>" } },
    { "kind": "timeout",  "op": "expire",       "subject": "<need pda>", "actor": { "name": "team-sol", "pubkey": "<pubkey>" } }
