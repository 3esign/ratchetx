.env*
.vercel/
backups/
node_modules/
test/
playwright-report/
test-results/

# The deploy is the site and its API — nothing else ships. onchain/ holds
# programs, experiments, and (never again unguarded) local keypairs; docs/,
# token/, agent/, ops/, supabase/ and the .cmd helpers are repository
# material, not web content. h69, after keypair files were found one deploy
# away from being publicly served.
onchain/
docs/
token/
agent/
ops/
supabase/
scripts/
tools/
*.cmd
*.md
# The public Agent Skill is executable discovery content, not repository docs.
# Keep this one exact Markdown file in the deployment while every other *.md
# remains excluded by the safety boundary above.
!skills/ratchetx/SKILL.md
# Only these exact portable public companions ship; other helpers stay private.
!skills/ratchetx/references/owner-session-test.md
!skills/ratchetx/references/owner-session-play.md
!skills/ratchetx/references/agent-modes.md
!skills/ratchetx/scripts/
skills/ratchetx/scripts/*
!skills/ratchetx/scripts/session-smoke.mjs
!skills/ratchetx/scripts/session-play.mjs
*keypair*.json
*.keys/
deploy_check.txt
mcp/
